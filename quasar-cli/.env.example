# ─────────────────────────────────────────────────────────────────────────────
# QUASAR CLI — Environment Configuration Template
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# Architecture:
#   - Ollama  : Always the fallback provider (local or cloud endpoint)
#   - Slot 1-4: Up to 4 independent OpenAI-compatible APIs, each with its own
#               base_url, model, and API keys (up to 2 rotation keys per slot)
#
# Only slots with CUSTOM_N_BASE_URL set are used. Unconfigured slots are skipped.
# ─────────────────────────────────────────────────────────────────────────────


# ─── PROVIDER: Ollama ────────────────────────────────────────────────────────
# Always available as the fallback. Uses cloud-tagged model names.
OLLAMA_BASE_URL=http://localhost:11434


# ─── SLOT 1: Primary (fast tasks — chat, search, execution) ──────────────────
# Best for: everyday queries, chat, search, terminal tasks
CUSTOM_1_BASE_URL=https://api.cerebras.ai/v1
CUSTOM_1_MODEL=zai-glm-4.7
CUSTOM_1_API_KEY_1=your-first-key
# CUSTOM_1_API_KEY_2=your-second-key   # optional rotation key


# ─── SLOT 2: Code Specialist (file_operations, code_intelligence) ─────────────
# Best for: large file edits, code review, refactoring
# CUSTOM_2_BASE_URL=https://api.groq.com/openai/v1
# CUSTOM_2_MODEL=openai/gpt-oss-120b
# CUSTOM_2_API_KEY_1=your-key
# CUSTOM_2_API_KEY_2=your-second-key


# ─── SLOT 3: Alternate / Fallback ─────────────────────────────────────────────
# CUSTOM_3_BASE_URL=https://openrouter.ai/api/v1
# CUSTOM_3_MODEL=openai/gpt-4o-mini
# CUSTOM_3_API_KEY_1=your-key


# ─── SLOT 4: Classification — Cheap & Fast ────────────────────────────────────
# Best for: task type classification calls (small, low-cost model)
# CUSTOM_4_BASE_URL=https://api.sambanova.ai/v1
# CUSTOM_4_MODEL=Meta-Llama-3.1-8B-Instruct
# CUSTOM_4_API_KEY_1=your-key


# ─────────────────────────────────────────────────────────────────────────────
# Slot assignment (controlled in config.py TASK_MODELS):
#   classification    → slot4 (cheap), then slot1, then ollama
#   file_operations   → slot2 (large context), slot1, then ollama
#   code_intelligence → slot2 (code model), ollama deepseek, then slot1
#   chat/search/exec  → slot1, then ollama
#
# Popular providers to use in any slot:
#   Cerebras:   CUSTOM_N_BASE_URL=https://api.cerebras.ai/v1
#               CUSTOM_N_MODEL=zai-glm-4.7          (free tier available)
#
#   Groq:       CUSTOM_N_BASE_URL=https://api.groq.com/openai/v1
#               CUSTOM_N_MODEL=openai/gpt-oss-120b  (free tier available)
#
#   OpenRouter: CUSTOM_N_BASE_URL=https://openrouter.ai/api/v1
#               CUSTOM_N_MODEL=openai/gpt-4o-mini
#
#   SambaNova:  CUSTOM_N_BASE_URL=https://api.sambanova.ai/v1
#               CUSTOM_N_MODEL=Meta-Llama-3.1-70B-Instruct
#
#   LM Studio:  CUSTOM_N_BASE_URL=http://localhost:1234/v1
#               CUSTOM_N_MODEL=your-loaded-model
#               CUSTOM_N_API_KEY_1=not-needed
# ─────────────────────────────────────────────────────────────────────────────
